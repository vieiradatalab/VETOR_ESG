   "source": [
    "# Coleta dos dados\n",
    "dfs = []\n",
    "\n",
    "for indicator in indicator_codes:\n",
    "\n",
    "    df_temp = fetch_indicator(indicator)\n",
    "\n",
    "    if not df_temp.empty:\n",
    "        dfs.append(df_temp)\n",
    "\n",
    "df = dfs[0]\n",
    "\n",
    "for other in dfs[1:]:\n",
    "\n",
    "    df = df.merge(\n",
    "        other,\n",
    "        on=[\"country_code\", \"country_name\", \"year\"],\n",
    "        how=\"outer\"\n",
    "    )\n",
    "\n",
    "df.head()"
   ]
  },
