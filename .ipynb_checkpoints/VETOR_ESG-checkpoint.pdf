   "source": [
    "# Matriz de distância entre países\n",
    "dist_matrix = pairwise_distances(\n",
    "    X_scaled,\n",
    "    metric=\"euclidean\"\n",
    ")\n",
    "\n",
    "dist_df = pd.DataFrame(\n",
    "    dist_matrix,\n",
    "    index=X_scaled.index,\n",
    "    columns=X_scaled.index\n",
    ")\n",
    "\n",
    "dist_df.head()"
   ]
  },
