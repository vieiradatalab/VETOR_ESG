   "source": [
    "# baixar o Geodataset\n",
    "\n",
    "# Carrega mapa mundial (Natural Earth)\n",
    "url = \"https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_admin_0_countries.geojson\"\n",
    "\n",
    "# filtro das colunas necessárias\n",
    "world = gpd.read_file(url)[[\"ADMIN\", \"geometry\"]]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "4d192de2-bc25-4e32-a803-e53ac0658104",
   "metadata": {},
   "outputs": [],
   "source": [
    "dist_df_map = dist_brazil.reset_index()\n",
    "dist_df_map.columns = [\"country_name\", \"distance_to_brazil\"]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "50c6011f-6a24-415c-a373-c45cf43e340a",
   "metadata": {},
   "outputs": [],
   "source": [
    "name_fix = {\n",
    "    \"United States\": \"United States\",\n",
    "    \"Russian Federation\": \"Russia\",\n",
    "    \"Egypt, Arab Rep.\": \"Egypt\",\n",
    "    \"Iran, Islamic Rep.\": \"Iran\",\n",
    "    \"Viet Nam\": \"Vietnam\",\n",
    "    \"Korea, Rep.\": \"South Korea\",\n",
    "}\n",
    "\n",
    "dist_df_map[\"country_name\"] = dist_df_map[\"country_name\"].replace(name_fix)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "9148aa56-2d06-4b77-bc5e-a64ebf2d6914",
   "metadata": {},
   "outputs": [],
   "source": [
    "world = world.merge(\n",
    "    dist_df_map,\n",
    "    how=\"left\",\n",
    "    left_on=\"ADMIN\",\n",
    "    right_on=\"country_name\"\n",
    ")"
   ]
  },
