   "source": [
    "# Contribuição das variáveis na distância ao Brasil\n",
    "brazil_vector = X_scaled.loc[\"Brazil\"]\n",
    "\n",
    "dist_components = (X_scaled - brazil_vector) ** 2\n",
    "\n",
    "dist_components.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "16241e1e-5bf9-46a3-8eef-f72c872244c7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Estrutura ESG dos países (PCA)\n",
    "pca = PCA(n_components=2)\n",
    "\n",
    "X_pca = pca.fit_transform(X_scaled)\n",
    "\n",
    "pca_df = pd.DataFrame(\n",
    "    X_pca,\n",
    "    columns=[\"PC1\",\"PC2\"],\n",
    "    index=X_scaled.index\n",
    ")"
   ]
  },
