   "source": [
    "# Preparação da base analítica\n",
    "df_model = df.copy()\n",
    "\n",
    "df_model = df_model.drop(columns=[\"country_code\", \"year\"])\n",
    "\n",
    "df_model = df_model.set_index(\"country_name\")\n",
    "\n",
    "df_model = df_model.dropna()\n",
    "\n",
    "df_model = df_model.rename(columns=indicator_names)\n",
    "\n",
    "df_model.head()"
   ]
  },
